# Copy to .env. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Host names the app is served from (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when served from an https origin, e.g. https://qna.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Trying it on http://localhost? Keep this 0. Behind HTTPS, set 1 and TRUST_PROXY_SSL=1.
COOKIE_SECURE=0
TRUST_PROXY_SSL=0

# Close public sign-up after creating your accounts
ALLOW_REGISTRATION=1
LLM_MODEL=mistral
